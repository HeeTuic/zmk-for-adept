# Adept BLE board configuration
# SPDX-License-Identifier: MIT

if BOARD_ADEPT_BLE

config BOARD
	default "adept_ble"

# nRF52840-QIAA: 1 MB flash, 256 KB RAM.
config FLASH_SIZE
	default 1024

config SRAM_SIZE
	default 256

if USB_DEVICE_STACK

config USB_NRFX
	default y

endif # USB_DEVICE_STACK

config BT_CTLR
	default BT

endif # BOARD_ADEPT_BLE
