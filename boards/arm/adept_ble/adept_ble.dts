/*
 * Adept BLE board
 *
 * MCU module: EBYTE E73-2G4M08S1C (nRF52833-QIAA, 512 KB flash / 128 KB RAM)
 *
 * SPDX-License-Identifier: MIT
 */

/dts-v1/;
#include <nordic/nrf52833_qiaa.dtsi>
#include "adept_ble-pinctrl.dtsi"

/ {
	model = "Adept BLE";
	compatible = "adept,ble";

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,battery = &vbatt;
	};

	leds {
		compatible = "gpio-leds";

		blue_led: led_0 {
			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			label = "Blue LED";
		};
	};

	/* VBAT divider: 820K high side, 2M low side, on E73 pad 18 (P0.04 / AIN2). */
	vbatt: vbatt {
		compatible = "zmk,battery-voltage-divider";
		io-channels = <&adc 2>;
		output-ohms = <2000000>;
		full-ohms = <(2000000 + 820000)>;
	};
};

&adc {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uicr {
	gpio-as-nreset;
};

&nfct {
	status = "disabled";
};

&spi1 {
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

zephyr_udc0: &usbd {
	status = "okay";
};

&flash0 {
	/*
	 * Adafruit nRF52 UF2 bootloader layout: the bootloader plus the S140
	 * SoftDevice occupy flash below 0x26000, so the application must be
	 * linked at 0x26000.  Storage sits at the top of the 512 KB flash.
	 */
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		sd_partition: partition@0 {
			reg = <0x00000000 0x00026000>;
		};
		code_partition: partition@26000 {
			reg = <0x00026000 0x000c6000>;
		};
		storage_partition: partition@ec000 {
			reg = <0x000ec000 0x00014000>;
		};
	};
};
