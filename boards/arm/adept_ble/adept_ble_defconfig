# Adept BLE board defaults (EBYTE E73 module, nRF52840)
# SPDX-License-Identifier: MIT

CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_ADEPT_BLE=y

# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# The Adafruit nRF52 bootloader on this board only accepts its own UF2 family
# id, so pin it to the Adafruit nRF52840 value rather than letting Zephyr
# derive one from the board name.
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0xADA52840"

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# 32.768 kHz crystal X1 is fitted on the module (E73 pads 11 / 13).
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
