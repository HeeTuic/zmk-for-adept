/*
 * Adept BLE: PMW3610 trackball.
 *
 * Pin assignment taken from the PCB netlist:
 *   SCLK   E73 pad 9 -> P0.31
 *   SDIO   E73 pad 8 -> P0.29   (bidirectional data)
 *   MOTION E73 pad 7 -> P0.02   (data-ready interrupt)
 *   NCS    E73 pad 6 -> P1.13
 *
 * The sensor has a single bidirectional data line, so SPI MOSI and MISO share
 * P0.29, which is how the reference driver is configured as well.
 *
 * SPDX-License-Identifier: MIT
 */

#include "adept_ble.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 29)>,
				<NRF_PSEL(SPIM_MISO, 0, 29)>;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 29)>,
				<NRF_PSEL(SPIM_MISO, 0, 29)>;
			low-power-enable;
		};
	};
};

&spi1 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	cs-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;

	trackball: trackball@0 {
		status = "okay";
		compatible = "pixart,pmw3610-alt";
		reg = <0>;
		spi-max-frequency = <2000000>;
		irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		cpi = <600>;
		evt-type = <INPUT_EV_REL>;
		x-input-code = <INPUT_REL_X>;
		y-input-code = <INPUT_REL_Y>;

		/* 传感器在结构上顺时针旋转了 90 度安装。
		 * 坐标变换应为 (x, y) -> (-y, x)：先交换 X/Y，再反转新的 Y 轴。
		 * 若方向仍不对，按下面组合二选一（一次只改一个）：
		 *   左右反 → 去掉 invert-y，保留 swap-xy
		 *   上下反 → 把 invert-y 换成 invert-x
		 *   整体反 180 度 → 保留 swap-xy，同时加 invert-x 与 invert-y */
		swap-xy;
		invert-y;

		/* Keep the sensor in RUN while ZMK is active; it doubles as a
		 * wakeup source.  Remove this if battery life matters more. */
		force-awake;
	};
};
