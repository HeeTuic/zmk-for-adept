/*
 * Adept BLE 键位表
 *
 * 出厂键位参照 Ploopy Adept 官方 QMK 默认键位
 * （QMK: keyboards/ploopyco/madromys/keymaps/default/keymap.c）
 *
 *   官方默认： LAYOUT( MS_BTN4, MS_BTN5, DRAG_SCROLL, MS_BTN2, MS_BTN1, MS_BTN3 )
 *   官方物理标签： Top Left Left / Top Left / Top Right / Top Right Right
 *                  / Bottom Left / Bottom Right
 *
 * 键位索引（从 0 开始，与 adept_ble.dtsi 的 kscan 顺序一一对应）：
 *   0 左上大    1 中左小    2 中右小    3 右上大
 *   4 左下(拇指) 5 右下(拇指)
 *
 * 层结构：
 *   第 0 层 Buttons   默认层
 *   第 1 层 Scroll    滚动层（中右小键按住进入；轨迹球变滚轮）
 *   第 2 层 Config    配置层（长按中左+中右进入；蓝牙与 Studio 管理）
 *
 * 每层绑定数量必须等于 transform 条目数（6）。
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/* 里面定义了 zip_xy_to_scroll_mapper（滚动层要用） */
#include <input/processors.dtsi>

/ {
	keymap {
		compatible = "zmk,keymap";

		/* 第 0 层：默认层
		 *   0 左上大   &mkp MCLK  中键（滚轮按下）
		 *   1 中左小   &mkp MB5   前进
		 *   2 中右小   &mo 1      按住进入滚动层
		 *   3 右上大   &mkp MB4   后退 / 切换程序
		 *   4 左下     &mkp LCLK  左键
		 *   5 右下     &mkp RCLK  右键
		 */
		buttons_layer: buttons {
			display-name = "Buttons";
			bindings = <
				&mkp MCLK  &mkp MB5  &mo 1  &mkp MB4  &mkp LCLK  &mkp RCLK
			>;
		};

		/* 第 1 层：滚动层。
		 * 轨迹球在该层滚动而不是移动指针（见 adept_ble.dtsi 的 scroller 节点）。
		 *
		 *   0 左上大   &kp LCTRL  按住 = Ctrl 修饰键，用于「Ctrl + 滚轮」缩放
		 *   1 中左小   &mkp MB5   前进
		 *   2 中右小   &trans     透传：它就是按住进入本层的键，松开自动回第 0 层
		 *   3 右上大   &mkp MB4   后退
		 *   4 左下     &mkp LCLK  左键
		 *   5 右下     &mkp RCLK  右键
		 *
		 * 为什么把左上大键改成 Ctrl：
		 *   很多软件（浏览器、CAD、看图、Office）的缩放是 Ctrl + 滚轮，
		 *   单纯滚轮只会滚动画面。而 ZMK 的 input-processor 无法在滚动时
		 *   自动加修饰键（behaviors 处理器只响应按键类事件，不响应位移），
		 *   所以只能提供一个 Ctrl 键，由用户按住后滚动。
		 *
		 *   选左上大键的理由：本层的 中左小 / 中右小 两键同时按下是进入配置层
		 *   的组合键，不能占用；剩下四个键里，中键（滚轮按下）在滚动场景中
		 *   最不常用，牺牲它的影响最小。左中右三个点击键全部保留，
		 *   所以滚动时仍可正常点选、拖拽。
		 *
		 * 用法：按住中右小键进入滚动 → 再按住左上大键 → 滚球即缩放；
		 *       若只想普通滚动，不要按左上大键即可。 */
		scroll_layer: scroll {
			display-name = "Scroll";
			bindings = <
				&kp LCTRL  &mkp MB5  &trans  &mkp MB4  &mkp LCLK  &mkp RCLK
			>;
		};

		/* 第 2 层：配置层（长按中左+中右进入，松手退出）
		 *   0 左上大   &bt BT_CLR        清除当前信道的蓝牙配对信息
		 *   1 中左小   &none            空（它同时是进入本层的组合键）
		 *   2 中右小   &none            空（同上）
		 *   3 右上大   &studio_unlock   解锁 ZMK Studio
		 *   4 左下     &bt BT_SEL 0     切换信道 1
		 *   5 右下     &bt BT_SEL 1     切换信道 2
		 *
		 * 本工程只使用 2 个蓝牙信道（ZMK 默认 5 个，这里只开放前两个）。
		 * 中键用 &none 而不是 &trans：&trans 会穿透到第 0 层的 &mo 1，
		 * 松手时会误切滚动层。 */
		config_layer: config {
			display-name = "Config";
			bindings = <
				&bt BT_CLR  &none  &none  &studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1
			>;
		};
	};
};
