/*
 * Physical layout for Adept BLE.
 *
 * X/Y come from the PCB footprint origins (1/100 mil, rounded) and only need
 * to be relatively correct; they are used for display.
 *
 * SPDX-License-Identifier: MIT
 */

/ {
	adept_layout: adept_layout {
		compatible = "zmk,physical-layout";
		display-name = "Adept BLE";

		keys  //                     w   h    x    y   rot  rx  ry
			= <&key_physical_attrs 100 100  582  284    0   0   0>   /* K1 */
			, <&key_physical_attrs 100 100  621  106    0   0   0>   /* K2 */
			, <&key_physical_attrs 100 100 1088  285    0   0   0>   /* K3 */
			, <&key_physical_attrs 100 100 1090  250    0   0   0>   /* K4 */
			, <&key_physical_attrs 100 100 2195  250    0   0   0>   /* K5 */
			, <&key_physical_attrs 100 100 2702  281    0   0   0>   /* K6 */
			;
	};
};
