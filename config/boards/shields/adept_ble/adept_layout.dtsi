/*
 * Adept BLE 物理布局
 *
 * 作用：给 Studio 与画键位图工具一个“按键在板子上的位置”描述。
 * 不影响按键功能，错了也只是显示位置不准。
 *
 * 坐标单位：1 单位 = 100（ZMK 惯用 1/100 英寸），X 向右、Y 向下。
 * 布局来源：由键盘布局编辑器导出的 KLE 坐标换算而来。
 *
 *   KLE 原始数据：
 *     上排 4 键 (y=0)：
 *       x0 h1.4 | x1 h1.2 | x2 h1.2 | x3 h1.4
 *     下方 2 个拇指大键 (y=2.75, w1.5, h1.7)：
 *       x0 (0~1.5) | x2.5 (2.5~4)
 *
 *   换算规则：X = x*100，Y = y*100，宽 = w*100，高 = h*100
 *
 * 必须 #include <physical_layouts.dtsi>（尖括号 = 取 ZMK 官方那份），
 * 因为 &key_physical_attrs 这个标签由官方定义。若在 shield 目录下放一个
 * 同名文件，引号 include 会优先命中本地文件而顶掉官方定义，解析就会失败。
 *
 * 每项 7 个参数：宽 高 X Y 旋转 旋转中心X 旋转中心Y
 *
 * SPDX-License-Identifier: MIT
 */

#include <physical_layouts.dtsi>

/ {
	adept_layout: adept_layout {
		compatible = "zmk,physical-layout";
		display-name = "Adept BLE";

		keys  //                     w   h    x    y   rot  rx  ry
			/* 上排 4 键 */
			= <&key_physical_attrs 100 140    0    0    0   0   0>   /* K1 左上大 */
			, <&key_physical_attrs 100 120  100    0    0   0   0>   /* K2 中左小 */
			, <&key_physical_attrs 100 120  200    0    0   0   0>   /* K3 中右小 */
			, <&key_physical_attrs 100 140  300    0    0   0   0>   /* K4 右上大 */
			/* 下方 2 个拇指键：索引 4 在左（X=0）、索引 5 在右（X=250）。
			 * 编辑器里点视觉左边 = 编辑索引 4，与物理左键一致。
			 * 若日后发现编辑器左右又反了，把这两个 X 值对调即可（不要动键值）。 */
			, <&key_physical_attrs 150 170    0  275    0   0   0>   /* K5 索引4 -> 左侧 */
			, <&key_physical_attrs 150 170  250  275    0   0   0>   /* K6 索引5 -> 右侧 */
			;
	};
};
