# XM001-Adept_BLE shield defaults
# SPDX-License-Identifier: MIT

if SHIELD_XM001_ADEPT_BLE

config ZMK_KEYBOARD_NAME
	default "XM001-Adept BLE"

# Battery reporting is on by default in ZMK; keep it explicit because this
# board reads VBAT through the R10/R11 divider on E73 pad 18.
config ZMK_BATTERY_REPORTING
	default y

# Studio is enabled for local (USB) builds only, see config/xm001_adept_ble.conf.
config ZMK_STUDIO
	default n

endif
